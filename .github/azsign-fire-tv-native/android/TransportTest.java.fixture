package com.carriez.flutter_hbb;
import com.sun.net.httpserver.HttpsServer;
import com.sun.net.httpserver.HttpsConfigurator;
import java.io.FileInputStream;
import java.net.InetSocketAddress;
import java.security.KeyStore;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.atomic.AtomicInteger;
import javax.net.ssl.KeyManagerFactory;
import javax.net.ssl.SSLContext;

public final class TransportTest {
 static void require(boolean condition) { if (!condition) throw new AssertionError(); }
 public static void main(String[] args) throws Exception {
  KeyStore keys = KeyStore.getInstance("PKCS12");
  try (FileInputStream in = new FileInputStream(args[0])) { keys.load(in, "fixture-password".toCharArray()); }
  KeyManagerFactory km = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm()); km.init(keys, "fixture-password".toCharArray());
  SSLContext tls = SSLContext.getInstance("TLS"); tls.init(km.getKeyManagers(), null, null);
  HttpsServer server = HttpsServer.create(new InetSocketAddress("127.0.0.1", 0), 0); server.setHttpsConfigurator(new HttpsConfigurator(tls));
  AtomicInteger mode = new AtomicInteger(), requests = new AtomicInteger(); List<String> events = new ArrayList<>();
  server.createContext("/", exchange -> {
   requests.incrementAndGet(); int status = 200; String body = "{\"osVersion\":\"fixture\"}";
   require("0987654321".equals(exchange.getRequestHeaders().getFirst("x-api-key")));
   if (exchange.getRequestURI().getQuery() != null) events.add(new String(exchange.getRequestBody().readAllBytes(), java.nio.charset.StandardCharsets.UTF_8));
   if (mode.get()==1) { status=302; exchange.getResponseHeaders().add("Location", "https://example.invalid/"); }
   if (mode.get()==2) body="x".repeat(65537);
   if (mode.get()==3) { status=401; body="sensitive-response-body"; }
   byte[] bytes=body.getBytes(java.nio.charset.StandardCharsets.UTF_8); exchange.sendResponseHeaders(status, bytes.length);
   try (java.io.OutputStream out=exchange.getResponseBody()) { out.write(bytes); }
  });
  server.start();
  try {
   int port = server.getAddress().getPort(); byte[] cert=FireTvTransport.discoverCertificate("127.0.0.1",port);
   FireTvTransport transport=new FireTvTransport("127.0.0.1",port,cert);
   require(transport.request("/v1/FireTV/status",null,"synthetic-token").contains("fixture"));
   transport.request("/v1/FireTV?action=dpad_right","{\"keyActionType\":\"keyDown\"}","synthetic-token");
   transport.request("/v1/FireTV?action=dpad_right","{\"keyActionType\":\"keyUp\"}","synthetic-token");
   require(events.size()==2 && events.get(0).contains("keyDown") && events.get(1).contains("keyUp"));
   int before=requests.get(); byte[] changed=cert.clone(); changed[changed.length-1]^=1;
   try { new FireTvTransport("127.0.0.1",port,changed).request("/v1/FireTV/status",null,"never-send-this-token"); throw new AssertionError(); } catch (javax.net.ssl.SSLException expected) {}
   require(requests.get()==before);
   mode.set(1); try { transport.request("/v1/FireTV/status",null,"synthetic-token"); throw new AssertionError(); } catch (FireTvTransport.HttpFailure expected) { require(expected.status==302); }
   mode.set(2); try { transport.request("/v1/FireTV/status",null,"synthetic-token"); throw new AssertionError(); } catch (java.io.IOException expected) { require(!expected.getMessage().contains("xxxx")); }
   mode.set(3); try { transport.request("/v1/FireTV/status",null,"synthetic-token"); throw new AssertionError(); } catch (FireTvTransport.HttpFailure expected) { require(expected.status==401 && !expected.getMessage().contains("sensitive")); }
   try { new FireTvTransport("192.0.2.1",port,cert); throw new AssertionError(); } catch (IllegalArgumentException expected) {}
   try { transport.request("/arbitrary-command",null,"synthetic-token"); throw new AssertionError(); } catch (IllegalArgumentException expected) {}
   try { transport.request("/v1/FireTV/status",null,"token\r\ninjection"); throw new AssertionError(); } catch (IllegalArgumentException expected) {}
   require(FireTvInputPolicy.supported("Amazon","AFTHY7ABBA",30));
   require(FireTvInputPolicy.supported("amazon","afthy7abba",30));
   require(!FireTvInputPolicy.supported("Amazon","AFTSS",30));
   require(!FireTvInputPolicy.supported("Other","AFTHY7ABBA",30));
   require(!FireTvInputPolicy.supported("Amazon","AFTHY7ABBA-X",30));
   require(!FireTvInputPolicy.supported("Amazon","AFTHY7ABBA",33));
   require(FireTvInputPolicy.navigation(22).equals("dpad_right"));
   require(FireTvInputPolicy.navigation(66).equals("select"));
   require(FireTvInputPolicy.navigation(29)==null);
   System.out.println("Transport and hardware policy checks passed.");
  } finally { server.stop(0); }
 }
}
