<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 rescap">
  <Identity Name="AZSign.Remote.Test" Publisher="CN=AZSign Remote MSIX Test" Version="1.5.2.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>AZSign Remote (Teste MSIX)</DisplayName>
    <PublisherDisplayName>AZSign</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Cliente de acesso remoto aos players AZSign. Pacote de teste interno.</Description>
  </Properties>
  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="Remote" Executable="AZSign Remote.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="AZSign Remote (Teste MSIX)"
                          Description="Cliente de acesso remoto aos players AZSign. Pacote de teste interno."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="azsign-remote" Parameters="&quot;%1&quot;">
            <uap:DisplayName>AZSign Remote</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
